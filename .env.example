# ─────────────────────────────────────────────────────────────
# DrumAsia — environment template.
# Copy to `.env.local` and fill the values you have.
# Every key marked [CONFIRM] is pending client / provider setup.
# See /docs/README.md and /docs/OPEN-QUESTIONS.md.
# ─────────────────────────────────────────────────────────────

# ── CMS (Sanity) — pending project creation ──
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
# SANITY_STUDIO_HOST=studio

# ── Analytics (cookieless, PDPA-friendly) ──
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=drumasia.example
# PLAUSIBLE_SERVER_URL=            # self-hosted only

# ── Email (Resend) — secondary fallback channel ──
# RESEND_API_KEY=
# ENQUIRY_NOTIFY_EMAIL=info@drum-asia.com

# ── Staff alerts (optional Telegram webhook) ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Mapping / routing provider (Live ETA, Load-In) ──
# [CONFIRM] which provider (Google Routes / Mapbox / TomTom) and who holds the key
# ROUTING_PROVIDER=
# ROUTING_API_KEY=

# ── Weather (motorcycle rain warning) ──
# WEATHER_PROVIDER=
# WEATHER_API_KEY=

# ── Founder portrait ──
# Optional direct image URL (https://...). Takes priority over the local
# drop-slot at public/founder/portrait.jpg. Either works — no code change.
# NEXT_PUBLIC_FOUNDER_PORTRAIT_URL=
